DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

GORGIAS_BASE_URL=https://your-store.gorgias.com
GORGIAS_USERNAME=your-gorgias-api-username
GORGIAS_API_KEY=your-gorgias-api-key

AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=provider/model-name:free

EXTERNAL_REQUEST_TIMEOUT_SECONDS=10
WEBHOOK_IDEMPOTENCY_TTL_SECONDS=3600
INTEGRATION_NAME=Gorgias AI Support Automation
GORGIAS_INTEGRATION_EMAIL=
GORGIAS_INTEGRATION_USER_ID=
